APP_NAME="Autonomous Data Scientist"
APP_ENVIRONMENT="development"

DATABASE_URL="postgresql+asyncpg://ads:ads@postgres:5432/ads"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
AUTH_SECRET_KEY="replace-with-long-random-secret"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="change-this-in-production"
BOOTSTRAP_ADMIN_NAME="Admin"
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0.1"
OTEL_EXPORTER_OTLP_ENDPOINT=""
APP_VERSION="0.1.0"

REDIS_URL="redis://redis:6379/0"
BACKGROUND_QUEUE_NAME="ads:analysis_queue"

STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="/data/uploads"
DEFAULT_USER_STORAGE_QUOTA_BYTES=10737418240
ANTIVIRUS_ENABLED=false
ANTIVIRUS_HOST=clamav
ANTIVIRUS_PORT=3310
ANTIVIRUS_TIMEOUT_SECONDS=30
BACKUP_DIR="/backups"

S3_ENDPOINT_URL=""
S3_BUCKET_NAME="datasets"
S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

OPENAI_API_KEY=""
NVIDIA_API_KEY=""
ANTHROPIC_API_KEY=""

MODEL_PROVIDER="openai"
MODEL_NAME="gpt-4o-mini"
MODEL_TEMPERATURE=0.2
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000


LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY="pk-lf-f17648c4-bf95-4c12-8853-592e0b87e021"
LANGFUSE_SECRET_KEY="sk-lf-9bb6c0db-6db0-4668-92db-4567e6ab1b64"
LANGFUSE_HOST="https://cloud.langfuse.com"

NEMO_GUARDRAILS_ENABLED=false
NEMO_GUARDRAILS_CONFIG_DIR="/app/guardrails"

CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

MAX_UPLOAD_BYTES=104857600
ALLOWED_DATASET_EXTENSIONS=".csv,.parquet,.json,.jsonl"

WORKER_CONCURRENCY=1
ANALYSIS_TIMEOUT_SECONDS=1800
