APP_NAME="Autonomous Data Scientist"
APP_ENVIRONMENT="production"

DATABASE_URL="postgresql+asyncpg://ads:CHANGE_ME@postgres:5432/ads"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

REDIS_URL="redis://:CHANGE_ME@redis:6379/0"
BACKGROUND_QUEUE_NAME="ads:analysis_queue"

STORAGE_BACKEND="s3"
S3_ENDPOINT_URL="http://minio:9000"
S3_BUCKET_NAME="datasets"
S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID="CHANGE_ME"
AWS_SECRET_ACCESS_KEY="CHANGE_ME"

MODEL_PROVIDER="openai"
MODEL_NAME="gpt-4o-mini"
MODEL_TEMPERATURE=0.2

OPENAI_API_KEY="CHANGE_ME"

LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY="CHANGE_ME"
LANGFUSE_SECRET_KEY="CHANGE_ME"
LANGFUSE_HOST="https://cloud.langfuse.com"

NEMO_GUARDRAILS_ENABLED=true
NEMO_GUARDRAILS_CONFIG_DIR="/app/guardrails"

CORS_ORIGINS="https://your-domain.com"

MAX_UPLOAD_BYTES=104857600
ALLOWED_DATASET_EXTENSIONS=".csv,.parquet,.json,.jsonl"

WORKER_CONCURRENCY=2
ANALYSIS_TIMEOUT_SECONDS=1800

AUTH_SECRET_KEY="at-least-32-random-characters-change-me"

BOOTSTRAP_ADMIN_EMAIL="admin@your-domain.com"
BOOTSTRAP_ADMIN_PASSWORD="CHANGE_THIS_PASSWORD"
BOOTSTRAP_ADMIN_NAME="Admin"
